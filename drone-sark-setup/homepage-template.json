              "id": "w_repair_card",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"background:#0a0a0a;border-radius:24px;padding:56px;display:flex;align-items:center;gap:48px;flex-wrap:wrap;\"><div style=\"flex:1;min-width:280px;\"><span style=\"display:inline-block;font-size:10px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,255,255,0.4);border:1px solid rgba(255,255,255,0.15);border-radius:4px;padding:5px 12px;margin-bottom:20px;\">REPAIR SERVICE</span><h2 style=\"font-size:36px;font-weight:800;color:#fff;line-height:1.15;margin:0 0 16px;\">Drone Repair &amp;<br>Maintenance</h2><p style=\"color:rgba(255,255,255,0.65);font-size:15px;line-height:1.75;margin:0 0 20px;\">Fast, professional drone repair by certified technicians. We fix all makes &amp; models — from sensor calibration to full motor overhauls.</p><ul style=\"list-style:none;padding:0;margin:0 0 28px;display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;\"><li style=\"color:rgba(255,255,255,0.7);font-size:14px;\">✓ All brands &amp; models</li><li style=\"color:rgba(255,255,255,0.7);font-size:14px;\">✓ Genuine spare parts</li><li style=\"color:rgba(255,255,255,0.7);font-size:14px;\">✓ Quick turnaround</li><li style=\"color:rgba(255,255,255,0.7);font-size:14px;\">✓ Service warranty</li></ul><a href=\"/product-category/repair/\" style=\"display:inline-flex;background:#fff;color:#000;padding:15px 32px;border-radius:8px;font-weight:700;font-size:14px;text-decoration:none;\">Book Repair →</a></div><div style=\"flex:1;min-width:240px;text-align:center;\"><div style=\"background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:40px;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;\"><p style=\"color:rgba(255,255,255,0.3);font-size:13px;\">🔁 Add repair/workshop image here</p></div></div></div>"
              },
